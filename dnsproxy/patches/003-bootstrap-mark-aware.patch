From 5fd6ca905370c5622779e9ca5505a965b32d9027 Mon Sep 17 00:00:00 2001
From: Dongming Han <handongming@gl-inet.com>
Date: Mon, 6 Jul 2026 12:23:31 +0800
Subject: [PATCH] dnsproxy: propagate request mark to bootstrap lookups

Delay upstream hostname resolution until the dial handler receives the
per-request context.  This lets bootstrap DNS queries inherit the same SO_MARK
as the downstream request that triggered the upstream dial.

Also isolate bootstrap cache entries by mark, host, and network so a hostname
resolved under one policy route cannot be reused by another policy.
---
 internal/bootstrap/bootstrap.go    | 44 ++++++++++++------------
 upstream/resolver.go               | 55 +++++++++++++++++++++---------
 upstream/resolver_internal_test.go |  4 ++-
 3 files changed, 64 insertions(+), 39 deletions(-)

diff --git a/internal/bootstrap/bootstrap.go b/internal/bootstrap/bootstrap.go
index 4bf8737..d0506cc 100644
--- a/internal/bootstrap/bootstrap.go
+++ b/internal/bootstrap/bootstrap.go
@@ -122,31 +122,33 @@ func ResolveDialContext(
 		return nil, fmt.Errorf("resolver is nil: %w", ErrNoResolvers)
 	}
 
-	ctx := context.Background()
-	if timeout > 0 {
-		var cancel func()
-		ctx, cancel = context.WithTimeout(ctx, timeout)
-		defer cancel()
-	}
+	return func(ctx context.Context, network Network, _ string) (conn net.Conn, err error) {
+		resolveCtx := ctx
+		if timeout > 0 {
+			var cancel func()
+			resolveCtx, cancel = context.WithTimeout(ctx, timeout)
+			defer cancel()
+		}
 
-	// TODO(e.burkov):  Use network properly, perhaps, pass it through options.
-	ips, err := r.LookupNetIP(ctx, NetworkIP, host)
-	if err != nil {
-		return nil, fmt.Errorf("resolving hostname: %w", err)
-	}
+		// TODO(e.burkov):  Use network properly, perhaps, pass it through options.
+		ips, err := r.LookupNetIP(resolveCtx, NetworkIP, host)
+		if err != nil {
+			return nil, fmt.Errorf("resolving hostname: %w", err)
+		}
 
-	if preferV6 {
-		slices.SortStableFunc(ips, netutil.PreferIPv6)
-	} else {
-		slices.SortStableFunc(ips, netutil.PreferIPv4)
-	}
+		if preferV6 {
+			slices.SortStableFunc(ips, netutil.PreferIPv6)
+		} else {
+			slices.SortStableFunc(ips, netutil.PreferIPv4)
+		}
 
-	addrs := make([]string, 0, len(ips))
-	for _, ip := range ips {
-		addrs = append(addrs, netip.AddrPortFrom(ip, port).String())
-	}
+		addrs := make([]string, 0, len(ips))
+		for _, ip := range ips {
+			addrs = append(addrs, netip.AddrPortFrom(ip, port).String())
+		}
 
-	return NewDialContext(timeout, l, addrs...), nil
+		return NewDialContext(timeout, l, addrs...)(ctx, network, "")
+	}, nil
 }
 
 // NewDialContext returns a DialHandler that dials addrs and returns the first
diff --git a/upstream/resolver.go b/upstream/resolver.go
index 2dbe8f8..02a246b 100644
--- a/upstream/resolver.go
+++ b/upstream/resolver.go
@@ -155,15 +155,14 @@ type ipResult struct {
 // must be either [bootstrap.NetworkIP4], [bootstrap.NetworkIP6], or
 // [bootstrap.NetworkIP].  host must be in a lower-case FQDN form.
 //
-// TODO(e.burkov):  Use context.
 func (r *UpstreamResolver) lookupNetIP(
-	_ context.Context,
+	ctx context.Context,
 	network bootstrap.Network,
 	host string,
 ) (result *ipResult, err error) {
 	switch network {
 	case bootstrap.NetworkIP4, bootstrap.NetworkIP6:
-		return r.request(host, network)
+		return r.request(ctx, host, network)
 	case bootstrap.NetworkIP:
 		// Go on.
 	default:
@@ -171,8 +170,8 @@ func (r *UpstreamResolver) lookupNetIP(
 	}
 
 	resCh := make(chan any, 2)
-	go r.resolveAsync(resCh, host, bootstrap.NetworkIP4)
-	go r.resolveAsync(resCh, host, bootstrap.NetworkIP6)
+	go r.resolveAsync(ctx, resCh, host, bootstrap.NetworkIP4)
+	go r.resolveAsync(ctx, resCh, host, bootstrap.NetworkIP6)
 
 	var errs []error
 	result = &ipResult{}
@@ -199,7 +198,11 @@ func (r *UpstreamResolver) lookupNetIP(
 //
 // TODO(e.burkov):  Consider NS and Extra sections when setting TTL.  Check out
 // what RFCs say about it.
-func (r *UpstreamResolver) request(host string, n bootstrap.Network) (res *ipResult, err error) {
+func (r *UpstreamResolver) request(
+	ctx context.Context,
+	host string,
+	n bootstrap.Network,
+) (res *ipResult, err error) {
 	var qtype uint16
 	switch n {
 	case bootstrap.NetworkIP4:
@@ -224,7 +227,7 @@ func (r *UpstreamResolver) request(host string, n bootstrap.Network) (res *ipRes
 
 	// As per [Upstream.Exchange] documentation, the response is always returned
 	// if no error occurred.
-	resp, err := r.Exchange(req)
+	resp, err := ExchangeContext(r.Upstream, ctx, req)
 	if err != nil {
 		return res, err
 	}
@@ -251,8 +254,13 @@ func (r *UpstreamResolver) request(host string, n bootstrap.Network) (res *ipRes
 
 // resolveAsync performs a single DNS lookup and sends the result to ch.  It's
 // intended to be used as a goroutine.
-func (r *UpstreamResolver) resolveAsync(resCh chan<- any, host, network string) {
-	res, err := r.request(host, network)
+func (r *UpstreamResolver) resolveAsync(
+	ctx context.Context,
+	resCh chan<- any,
+	host string,
+	network bootstrap.Network,
+) {
+	res, err := r.request(ctx, host, network)
 	if err != nil {
 		resCh <- err
 	} else {
@@ -272,7 +280,14 @@ type CachingResolver struct {
 	// cache is the set of resolved hostnames mapped to cached addresses.
 	//
 	// TODO(e.burkov):  Use expiration cache.
-	cache map[string]*ipResult
+	cache map[resolverCacheKey]*ipResult
+}
+
+// resolverCacheKey keeps bootstrap results separate between policy marks.
+type resolverCacheKey struct {
+	host    string
+	network bootstrap.Network
+	mark    uint32
 }
 
 // NewCachingResolver creates a new caching resolver that uses r for lookups.
@@ -280,7 +295,7 @@ func NewCachingResolver(r *UpstreamResolver) (cr *CachingResolver) {
 	return &CachingResolver{
 		resolver: r,
 		mu:       &sync.RWMutex{},
-		cache:    map[string]*ipResult{},
+		cache:    map[resolverCacheKey]*ipResult{},
 	}
 }
 
@@ -298,8 +313,14 @@ func (r *CachingResolver) LookupNetIP(
 ) (addrs []netip.Addr, err error) {
 	now := time.Now()
 	host = dns.Fqdn(strings.ToLower(host))
+	mark, _ := bootstrap.MarkFromContext(ctx)
+	key := resolverCacheKey{
+		host:    host,
+		network: network,
+		mark:    mark,
+	}
 
-	addrs = r.findCached(host, now)
+	addrs = r.findCached(key, now)
 	if addrs != nil {
 		return slices.Clone(addrs), nil
 	}
@@ -309,18 +330,18 @@ func (r *CachingResolver) LookupNetIP(
 		return []netip.Addr{}, err
 	}
 
-	r.setCached(host, res)
+	r.setCached(key, res)
 
 	return slices.Clone(res.addrs), nil
 }
 
 // findCached returns the cached addresses for host if it's not expired yet, and
 // the corresponding cached result, if any.  It's safe for concurrent use.
-func (r *CachingResolver) findCached(host string, now time.Time) (addrs []netip.Addr) {
+func (r *CachingResolver) findCached(key resolverCacheKey, now time.Time) (addrs []netip.Addr) {
 	r.mu.RLock()
 	defer r.mu.RUnlock()
 
-	res, ok := r.cache[host]
+	res, ok := r.cache[key]
 	if !ok || res.expire.Before(now) {
 		return nil
 	}
@@ -330,9 +351,9 @@ func (r *CachingResolver) findCached(host string, now time.Time) (addrs []netip.
 
 // setCached sets the result into the address cache for host.  It's safe for
 // concurrent use.
-func (r *CachingResolver) setCached(host string, res *ipResult) {
+func (r *CachingResolver) setCached(key resolverCacheKey, res *ipResult) {
 	r.mu.Lock()
 	defer r.mu.Unlock()
 
-	r.cache[host] = res
+	r.cache[key] = res
 }
diff --git a/upstream/resolver_internal_test.go b/upstream/resolver_internal_test.go
index 0ac1373..7270122 100644
--- a/upstream/resolver_internal_test.go
+++ b/upstream/resolver_internal_test.go
@@ -3,11 +3,13 @@ package upstream
 import (
 	"net/netip"
 	"time"
+
+	"github.com/AdguardTeam/dnsproxy/internal/bootstrap"
 )
 
 // FindCached exports the internal method r.findCached for testing.
 //
 // TODO(e.burkov):  Find a way of testing without it.
 func (r *CachingResolver) FindCached(host string, now time.Time) (addrs []netip.Addr) {
-	return r.findCached(host, now)
+	return r.findCached(resolverCacheKey{host: host, network: bootstrap.NetworkIP}, now)
 }
