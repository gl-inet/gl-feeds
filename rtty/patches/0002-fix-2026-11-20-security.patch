From 37faedbca095bed085f3378d60eb0653e4434afb Mon Sep 17 00:00:00 2001
From: Jianhui Zhao <jianhui.zhao@gl-inet.com>
Date: Fri, 20 Nov 2026 20:39:56 +0800
Subject: [PATCH] rtty: apply security restrictions to 8.1.5

1. mask of `-f`
2. force enable tls
3. remove remote execute command
4. mask of `-x`

Rebase the patch onto rtty 8.1.5 before patches 003, 004 and 005.
Force TLS before option parsing to avoid overlapping patch 003's signal
handler hunk. The 8.1.5 command handler has no user_active assignment.

Signed-off-by: Jianhui Zhao <jianhui.zhao@gl-inet.com>
---
diff --git a/src/main.c b/src/main.c
--- a/src/main.c
+++ b/src/main.c
@@ -133,6 +133,9 @@
     strcat(shortopts, "sC:xc:k:");
 #endif
 
+    /* Require TLS even when -s is omitted. */
+    rtty.ssl_on = true;
+
     while (true) {
         c = getopt_long(argc, argv, shortopts, long_options, &option_index);
         if (c == -1)
@@ -170,8 +173,7 @@
             has_cacert = true;
             break;
         case 'x':
-            rtty.insecure = true;
-            ssl_set_require_validation(rtty.ssl_ctx, false);
+            /* Keep certificate verification enabled. */
             break;
         case 'c':
             if (ssl_load_cert_file(rtty.ssl_ctx, optarg)) {
@@ -193,7 +195,7 @@
             rtty.token = optarg;
             break;
         case 'f':
-            rtty.username = optarg;
+            /* Do not allow forced login without authentication. */
             break;
         case 'R':
             request_transfer_file('R', NULL);
diff --git a/src/rtty.c b/src/rtty.c
--- a/src/rtty.c
+++ b/src/rtty.c
@@ -444,7 +444,7 @@
             break;
 
         case MSG_TYPE_CMD:
-            run_command(rtty, buffer_data(rb));
+            /* Discard remote command requests. */
             buffer_pull(rb, NULL, msglen);
             break;
 
