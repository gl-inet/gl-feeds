From 3ef33802d1b94785be513353604c233096896711 Mon Sep 17 00:00:00 2001
From: Jianhui Zhao <jianhui.zhao@gl-inet.com>
Date: Thu, 25 Jun 2026 09:08:36 +0800
Subject: [PATCH] feat: compatible with 3.x

Signed-off-by: Jianhui Zhao <jianhui.zhao@gl-inet.com>
---
 eco.c    |  22 ++++++++++-
 file.lua | 114 +++++++++++++++++++++++++++++++++++++++++++++++++++++++
 sys.lua  |   4 ++
 3 files changed, 138 insertions(+), 2 deletions(-)

diff --git a/eco.c b/eco.c
index a10c6be..f9f2526 100644
--- a/eco.c
+++ b/eco.c
@@ -202,6 +202,25 @@ static struct eco_scheduler *get_eco_scheduler(lua_State *L)
     return sched;
 }
 
+static bool eco_push_panic_hook(lua_State *L, struct eco_scheduler *sched)
+{
+    if (sched->panic_hook != LUA_NOREF) {
+        lua_rawgeti(L, LUA_REGISTRYINDEX, sched->panic_hook);
+        return true;
+    }
+
+    lua_getglobal(L, "eco");
+    lua_getfield(L, -1, "panic_hook");
+    lua_remove(L, -2);
+
+    if (!lua_isfunction(L, -1)) {
+        lua_pop(L, 1);
+        return false;
+    }
+
+    return true;
+}
+
 static void eco_resume(lua_State *L, lua_State *co, int narg)
 {
     struct eco_scheduler *sched = get_eco_scheduler(L);
@@ -233,8 +252,7 @@ static void eco_resume(lua_State *L, lua_State *co, int narg)
         luaL_traceback(L, co, lua_tostring(co, -1), 0);
         luaL_traceback(L, L, NULL, 0);
 
-        if (sched->panic_hook != LUA_NOREF) {
-            lua_rawgeti(L, LUA_REGISTRYINDEX, sched->panic_hook);
+        if (eco_push_panic_hook(L, sched)) {
             lua_insert(L, -3);
             lua_call(L, 2, 0);
         } else {
diff --git a/file.lua b/file.lua
index 32f7974..e66a531 100644
--- a/file.lua
+++ b/file.lua
@@ -31,6 +31,26 @@ local M = {
     SKIP = 1
 }
 
+local function compat_resolve_fd(target)
+    if type(target) == 'number' then
+        return target
+    end
+
+    if type(target) ~= 'table' then
+        error('bad argument #1 (number or fd-backed object expected)', 3)
+    end
+
+    if type(target.getfd) == 'function' then
+        return target:getfd()
+    end
+
+    if type(target.fd) == 'number' then
+        return target.fd
+    end
+
+    error('bad argument #1 (number or fd-backed object expected)', 3)
+end
+
 --- Read contents from a file.
 --
 -- Opens the file in read-only mode and reads data using `file:read`.
@@ -97,6 +117,45 @@ function M.writefile(path, data, append)
     return true
 end
 
+--- Read from a file object or raw file descriptor.
+--
+-- Compatibility wrapper for lua-eco 3.x style `file.read(fd, n)`.
+-- For raw file descriptors, this wrapper supports integer reads.
+--
+-- @function read
+-- @tparam file|integer f File object or raw file descriptor.
+-- @tparam integer format Bytes to read.
+-- @tparam[opt] number timeout Timeout in seconds.
+function M.read(f, format, timeout)
+    if type(f) == 'table' and type(f.read) == 'function' then
+        return f:read(format, timeout)
+    end
+
+    local fd = compat_resolve_fd(f)
+    local rd = eco.reader(fd)
+
+    return rd:read(format, timeout)
+end
+
+--- Write to a file object or raw file descriptor.
+--
+-- Compatibility wrapper for lua-eco 3.x style `file.write(fd, data)`.
+--
+-- @function write
+-- @tparam file|integer f File object or raw file descriptor.
+-- @tparam string data Data to write.
+-- @tparam[opt] number timeout Timeout in seconds.
+function M.write(f, data, timeout)
+    if type(f) == 'table' and type(f.write) == 'function' then
+        return f:write(data, timeout)
+    end
+
+    local fd = compat_resolve_fd(f)
+    local wr = eco.writer(fd)
+
+    return wr:write(data, timeout)
+end
+
 --- File object returned by @{open}.
 --
 -- This object wraps a file descriptor.
@@ -205,6 +264,61 @@ function file_methods:flock(operation, timeout)
     end
 end
 
+--- Acquire or release an advisory file lock.
+--
+-- Compatibility wrapper for lua-eco 3.x style `file.flock(f, operation)`.
+-- This intentionally follows the v3.x module-level retry semantics instead of
+-- delegating to the 4.x `file:flock()` method.
+--
+-- @function flock
+-- @tparam file|integer f File object or raw file descriptor.
+-- @tparam integer operation Lock operation (`file.LOCK_SH`, `file.LOCK_EX`, `file.LOCK_UN`).
+-- @tparam[opt] number timeout Timeout in seconds.
+function M.flock(f, operation, timeout)
+    local fd = f
+    local deadtime
+
+    if type(f) == 'table' then
+        fd = f.fd
+    end
+
+    if timeout then
+        deadtime = sys.uptime() + timeout
+    end
+
+    while true do
+        local ok, errno = file.flock(fd, operation)
+        if ok then
+            return true
+        end
+
+        if errno ~= sys.EAGAIN then
+            return false, sys.strerror(errno)
+        end
+
+        if deadtime and sys.uptime() > deadtime then
+            return false, 'timeout'
+        end
+
+        time.sleep(0.1)
+    end
+end
+
+--- Close a file object or raw file descriptor.
+--
+-- Compatibility wrapper for lua-eco 3.x style `file.close(f)`.
+-- New code should prefer @{file:close}.
+--
+-- @function close
+-- @tparam file|integer f File object or raw file descriptor.
+function M.close(f)
+    if type(f) == 'table' then
+        return f:close()
+    end
+
+    return file.close(f)
+end
+
 --- Close the file.
 --
 -- This is idempotent and is also used as the `__gc` / `__close` metamethod.
diff --git a/sys.lua b/sys.lua
index ab95fd1..7718949 100644
--- a/sys.lua
+++ b/sys.lua
@@ -389,6 +389,10 @@ function signal_methods:close()
     self.sfd = nil
 end
 
+--- Compatibility alias for lua-eco 3.x.
+-- @function signal_handle:cancel
+signal_methods.cancel = signal_methods.close
+
 --- End of `signal` class section.
 -- @section end
 
-- 
2.53.0

