From: haoming.liao <haoming.liao@gl-inet.com>
Date: Thu, 05 Nov 2026 14:44:25 +0800
Subject: [PATCH] feat(nl80211): expose 2.4 GHz HT secondary-channel offset

Parse the HT Operation information element for 2.4 GHz scan entries and
expose the secondary-channel offset. This lets same-PHY repeater code
preserve HT40+ versus HT40- instead of inferring the extension direction
from the primary channel.

Keep the existing scan bandwidth and center-channel output unchanged.

---
 nl/nl80211.lua | 28 ++++++++++++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/nl/nl80211.lua b/nl/nl80211.lua
--- a/nl/nl80211.lua
+++ b/nl/nl80211.lua
@@ -86,6 +86,7 @@ local M = {
     -- Element IDs (IEEE Std 802.11-2020, 9.4.2.1, Table 9-92)
     WLAN_EID_SSID = 0,
     WLAN_EID_RSN = 48,
+    WLAN_EID_HT_OPERATION = 61,
     WLAN_EID_MESH_ID = 114,
     WLAN_EID_VENDOR_SPECIFIC = 221,
 }
@@ -121,6 +122,7 @@ local M = {
 -- @field beacon_interval int|nil Beacon interval.
 -- @field rsn table|nil RSN information (parsed).
 -- @field wpa table|nil WPA information (parsed).
+-- @field sec_channel_offset int|nil Secondary-channel offset (-1, 0, or 1) for 2.4 GHz HT.
 -- @field status string|nil Link status: authenticated/associated/ibss_joined.
 -- @field elems table|nil Raw parsed information elements (when keep_elems is true).
 -- @field bandwidth int|nil AP operating width in MHz (when bandwidth is true); 0 if unknown.
@@ -797,6 +799,30 @@ local function parse_vendor_specific_ie(info, data, fallback)
     end
 end
 
+local function parse_ht_operation_ie(info, data)
+    if info.band ~= 2.4 or #data < 2 then
+        return
+    end
+
+    local operation = str_byte(data, 2)
+    local offset = operation & 0x03
+    local allows_40mhz = (operation & 0x04) ~= 0
+
+    if not allows_40mhz or (offset ~= 1 and offset ~= 3) then
+        info.sec_channel_offset = 0
+        return
+    end
+
+    local sec = offset == 1 and 1 or -1
+    local secondary_channel = info.channel + 4 * sec
+
+    if secondary_channel < 1 or secondary_channel > 13 then
+        return
+    end
+
+    info.sec_channel_offset = sec
+end
+
 local function parse_bss_ie(info, data, keep_elems, fallback)
     local elems = {}
 
@@ -814,6 +840,8 @@ local function parse_bss_ie(info, data, keep_elems, fallback)
             if not fallback or not info.ssid then
                 info.ssid = elem_data
             end
+        elseif typ == M.WLAN_EID_HT_OPERATION then
+            parse_ht_operation_ie(info, elem_data)
         elseif typ == M.WLAN_EID_RSN then
             if not fallback or not info.rsn then
                 local rsn = parse_rsn(elem_data, 'CCMP', '8021x')
