diff --git a/proxy/conntrack_linux.go b/proxy/conntrack_linux.go
new file mode 100644
index 0000000..53d930f
--- /dev/null
+++ b/proxy/conntrack_linux.go
@@ -0,0 +1,68 @@
+//go:build linux
+
+package proxy
+
+import (
+	"encoding/binary"
+	"fmt"
+	"net"
+	"syscall"
+
+	"github.com/vishvananda/netlink/nl"
+	"golang.org/x/sys/unix"
+)
+
+// getConnMark performs one CT_GET lookup for the inbound DNS flow. The
+// kernel can send a multipart-flagged flow followed by an ACK without DONE.
+func (p *Proxy) getConnMark(local, remote net.IP, localPort, remotePort uint16, proto uint8) (uint32, error) {
+	if !p.EnableConntrack {
+		return 0, nil
+	}
+	family, srcType, dstType := unix.AF_INET6, nl.CTA_IP_V6_SRC, nl.CTA_IP_V6_DST
+	if remote.To4() != nil {
+		family, srcType, dstType = unix.AF_INET, nl.CTA_IP_V4_SRC, nl.CTA_IP_V4_DST
+		local, remote = local.To4(), remote.To4()
+	}
+	req := nl.NewNetlinkRequest(unix.NFNL_SUBSYS_CTNETLINK<<8|nl.IPCTNL_MSG_CT_GET, unix.NLM_F_ACK)
+	req.AddData(&nl.Nfgenmsg{NfgenFamily: uint8(family)})
+	tuple := nl.NewRtAttr(unix.NLA_F_NESTED|nl.CTA_TUPLE_ORIG, nil)
+	ip := tuple.AddRtAttr(unix.NLA_F_NESTED|nl.CTA_TUPLE_IP, nil)
+	ip.AddRtAttr(srcType, remote)
+	ip.AddRtAttr(dstType, local)
+	transport := tuple.AddRtAttr(unix.NLA_F_NESTED|nl.CTA_TUPLE_PROTO, nil)
+	transport.AddRtAttr(nl.CTA_PROTO_NUM, []byte{proto})
+	transport.AddRtAttr(nl.CTA_PROTO_SRC_PORT, nl.BEUint16Attr(remotePort))
+	transport.AddRtAttr(nl.CTA_PROTO_DST_PORT, nl.BEUint16Attr(localPort))
+	req.AddData(tuple)
+	msgs, err := req.Execute(unix.NETLINK_NETFILTER, 0)
+	if err != nil {
+		return 0, fmt.Errorf("conntrack lookup: %w", err)
+	}
+	if len(msgs) != 1 || len(msgs[0]) < 4 {
+		return 0, fmt.Errorf("invalid conntrack response")
+	}
+	attrs, err := nl.ParseRouteAttr(msgs[0][4:])
+	if err != nil {
+		return 0, err
+	}
+	for _, attr := range attrs {
+		if attr.Attr.Type == nl.CTA_MARK {
+			if len(attr.Value) != 4 {
+				return 0, fmt.Errorf("invalid conntrack mark length %d", len(attr.Value))
+			}
+			return binary.BigEndian.Uint32(attr.Value), nil
+		}
+	}
+	// Linux may omit CTA_MARK for an existing unmarked flow.
+	return 0, nil
+}
+
+// GetConnectionMark returns the mark of a TCP connection.
+func (p *Proxy) GetConnectionMark(localAddr, remoteAddr *net.TCPAddr) (uint32, error) {
+	return p.getConnMark(localAddr.IP, remoteAddr.IP, uint16(localAddr.Port), uint16(remoteAddr.Port), syscall.IPPROTO_TCP)
+}
+
+// GetUDPConnectionMark returns the mark of a UDP connection.
+func (p *Proxy) GetUDPConnectionMark(localAddr, remoteAddr *net.UDPAddr) (uint32, error) {
+	return p.getConnMark(localAddr.IP, remoteAddr.IP, uint16(localAddr.Port), uint16(remoteAddr.Port), syscall.IPPROTO_UDP)
+}
