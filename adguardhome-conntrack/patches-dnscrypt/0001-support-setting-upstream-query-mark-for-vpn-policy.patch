From 1be26fabf3e617b32baa7f757163fb5db10fe79c Mon Sep 17 00:00:00 2001
From: Dongming Han <handongming@gl-inet.com>
Date: Mon, 23 Nov 2026 17:35:31 +0800
Subject: [PATCH] 0001-support-setting-upstream-query-mark-for-vpn-policy

---
 client.go | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/client.go b/client.go
index a6f34e6..93556cb 100644
--- a/client.go
+++ b/client.go
@@ -56,6 +56,11 @@ type ClientConfig struct {
 	// UDPSize is the maximum size of a DNS response (or query) this client
 	// can send or receive.  If not set, we use [dns.MinMsgSize] by default.
 	UDPSize int
+
+	// Dialer is a custom dialer function for creating network connections.
+	// If not set, net.Dial will be used by default.
+	// This allows setting connection marks and other socket options.
+	Dialer *net.Dialer
 }
 
 // Client is a DNSCrypt resolver client.
@@ -70,7 +75,7 @@ type Client struct {
 func NewClient(conf *ClientConfig) (c *Client) {
 	return &Client{
 		logger:  cmp.Or(conf.Logger, slog.Default()),
-		dialer:  &net.Dialer{},
+		dialer:  cmp.Or(conf.Dialer, &net.Dialer{}),
 		proto:   conf.Proto,
 		udpSize: cmp.Or(conf.UDPSize, dns.MinMsgSize),
 	}
@@ -304,7 +309,7 @@ func (c *Client) fetchCert(
 
 	query := &dns.Msg{}
 	query.SetQuestion(providerName, dns.TypeTXT)
-	client := dns.Client{Net: string(c.proto), UDPSize: uint16(defaultUDPSize)}
+	client := dns.Client{Dialer: c.dialer, Net: string(c.proto), UDPSize: uint16(defaultUDPSize)}
 	r, _, err := client.ExchangeContext(ctx, query, stamp.ServerAddrStr)
 	if err != nil {
 		return nil, fmt.Errorf("sending dns query: %w", err)
-- 
2.34.1

