+++ b/dnscrypt-proxy/conntrack_context.go
@@ -0,0 +1,14 @@
+package main
+
+import "context"
+
+type conntrackMarkContextKey struct{}
+
+func withConntrackMark(ctx context.Context, mark uint32) context.Context {
+	return context.WithValue(ctx, conntrackMarkContextKey{}, mark)
+}
+
+func conntrackMarkFromContext(ctx context.Context) (uint32, bool) {
+	mark, ok := ctx.Value(conntrackMarkContextKey{}).(uint32)
+	return mark, ok
+}
diff --git a/dnscrypt-proxy/conntrack_linux.go b/dnscrypt-proxy/conntrack_linux.go
new file mode 100644
index 0000000000..ec27263c5f
--- /dev/null
+++ b/dnscrypt-proxy/conntrack_linux.go
@@ -0,0 +1,264 @@
+//go:build linux
+
+package main
+
+import (
+	"context"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"net"
+	"syscall"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+const (
+	nfNetlinkV0       = 0
+	nfSubsysCTNetlink = 1
+	ipctnlMsgCTNew    = 0
+	ipctnlMsgCTGet    = 1
+
+	nlaFNested       = 1 << 15
+	nlaFNetByteorder = 1 << 14
+	nlaTypeMask      = ^uint16(nlaFNested | nlaFNetByteorder)
+
+	ctaTupleOrig  = 1
+	ctaMark       = 8
+	ctaTupleIP    = 1
+	ctaTupleProto = 2
+	ctaIPV4Src    = 1
+	ctaIPV4Dst    = 2
+	ctaIPV6Src    = 3
+	ctaIPV6Dst    = 4
+	ctaProtoNum   = 1
+	ctaProtoSrc   = 2
+	ctaProtoDst   = 3
+)
+
+var errConntrackNotFound = errors.New("connection not found in conntrack table")
+
+func conntrackDialer(ctx context.Context, timeout, keepAlive time.Duration) *net.Dialer {
+	dialer := &net.Dialer{
+		Timeout:   timeout,
+		KeepAlive: keepAlive,
+		DualStack: true,
+	}
+	mark, ok := conntrackMarkFromContext(ctx)
+	if !ok {
+		return dialer
+	}
+	dialer.Control = func(_, _ string, c syscall.RawConn) error {
+		return setConntrackMarkRaw(c, mark)
+	}
+	return dialer
+}
+
+func listenUDPWithConntrackMark(ctx context.Context, network string) (*net.UDPConn, error) {
+	mark, ok := conntrackMarkFromContext(ctx)
+	listenConfig := net.ListenConfig{}
+	if ok {
+		listenConfig.Control = func(_, _ string, c syscall.RawConn) error {
+			return setConntrackMarkRaw(c, mark)
+		}
+	}
+	conn, err := listenConfig.ListenPacket(ctx, network, ":0")
+	if err != nil {
+		return nil, err
+	}
+	udpConn, ok := conn.(*net.UDPConn)
+	if !ok {
+		_ = conn.Close()
+		return nil, fmt.Errorf("unexpected packet connection type %T", conn)
+	}
+	return udpConn, nil
+}
+
+func setConntrackMarkRaw(c syscall.RawConn, mark uint32) error {
+	var sockErr error
+	if err := c.Control(func(fd uintptr) {
+		sockErr = unix.SetsockoptInt(int(fd), unix.SOL_SOCKET, unix.SO_MARK, int(mark))
+	}); err != nil {
+		return err
+	}
+	return sockErr
+}
+
+func (proxy *Proxy) clientConntrackMark(clientProto string, clientPc net.Conn, clientAddr *net.Addr) (uint32, error) {
+	if !proxy.enableConntrack {
+		return 0, nil
+	}
+	switch clientProto {
+	case "tcp":
+		localAddr, lok := clientPc.LocalAddr().(*net.TCPAddr)
+		remoteAddr, rok := clientPc.RemoteAddr().(*net.TCPAddr)
+		if !lok || !rok {
+			return 0, fmt.Errorf("unexpected TCP address types: local=%T remote=%T", clientPc.LocalAddr(), clientPc.RemoteAddr())
+		}
+		return getConntrackMark(localAddr.IP, remoteAddr.IP, uint16(localAddr.Port), uint16(remoteAddr.Port), syscall.IPPROTO_TCP)
+	case "udp":
+		udpConn, ok := clientPc.(*net.UDPConn)
+		if !ok {
+			return 0, fmt.Errorf("unexpected UDP connection type %T", clientPc)
+		}
+		localAddr, lok := udpConn.LocalAddr().(*net.UDPAddr)
+		remoteAddr, rok := (*clientAddr).(*net.UDPAddr)
+		if !lok || !rok {
+			return 0, fmt.Errorf("unexpected UDP address types: local=%T remote=%T", udpConn.LocalAddr(), *clientAddr)
+		}
+		return getConntrackMark(localAddr.IP, remoteAddr.IP, uint16(localAddr.Port), uint16(remoteAddr.Port), syscall.IPPROTO_UDP)
+	default:
+		return 0, nil
+	}
+}
+
+func getConntrackMark(src, dst net.IP, srcPort, dstPort uint16, proto uint8) (uint32, error) {
+	mark, err := queryConntrackMark(src, dst, srcPort, dstPort, proto)
+	if err == nil {
+		return mark, nil
+	}
+	reverseMark, reverseErr := queryConntrackMark(dst, src, dstPort, srcPort, proto)
+	if reverseErr == nil {
+		return reverseMark, nil
+	}
+	return 0, err
+}
+
+func queryConntrackMark(src, dst net.IP, srcPort, dstPort uint16, proto uint8) (uint32, error) {
+	family, attrs, err := conntrackTupleAttrs(src, dst, srcPort, dstPort, proto)
+	if err != nil {
+		return 0, err
+	}
+	req := conntrackNetlinkRequest(family, attrs)
+	fd, err := unix.Socket(unix.AF_NETLINK, unix.SOCK_RAW|unix.SOCK_CLOEXEC, unix.NETLINK_NETFILTER)
+	if err != nil {
+		return 0, err
+	}
+	defer unix.Close(fd)
+	if err := unix.Bind(fd, &unix.SockaddrNetlink{Family: unix.AF_NETLINK}); err != nil {
+		return 0, err
+	}
+	if err := unix.Sendto(fd, req, 0, &unix.SockaddrNetlink{Family: unix.AF_NETLINK}); err != nil {
+		return 0, err
+	}
+
+	buf := make([]byte, 65536)
+	for {
+		n, _, err := unix.Recvfrom(fd, buf, 0)
+		if err != nil {
+			return 0, err
+		}
+		msgs, err := syscall.ParseNetlinkMessage(buf[:n])
+		if err != nil {
+			return 0, err
+		}
+		for _, msg := range msgs {
+			switch msg.Header.Type {
+			case syscall.NLMSG_ERROR:
+				if len(msg.Data) < 4 {
+					return 0, errors.New("short netlink error message")
+				}
+				errno := int32(binary.NativeEndian.Uint32(msg.Data[:4]))
+				if errno == 0 {
+					continue
+				}
+				if errno == -int32(unix.ENOENT) {
+					return 0, errConntrackNotFound
+				}
+				return 0, unix.Errno(-errno)
+			case syscall.NLMSG_DONE:
+				return 0, errConntrackNotFound
+			default:
+				if msg.Header.Type != conntrackNetlinkMsgType(ipctnlMsgCTNew) &&
+					msg.Header.Type != conntrackNetlinkMsgType(ipctnlMsgCTGet) {
+					continue
+				}
+				return parseConntrackMark(msg.Data), nil
+			}
+		}
+	}
+}
+
+func conntrackNetlinkRequest(family int, attrs []byte) []byte {
+	msgLen := syscall.NLMSG_HDRLEN + 4 + len(attrs)
+	req := make([]byte, msgLen)
+	binary.NativeEndian.PutUint32(req[0:4], uint32(msgLen))
+	binary.NativeEndian.PutUint16(req[4:6], conntrackNetlinkMsgType(ipctnlMsgCTGet))
+	binary.NativeEndian.PutUint16(req[6:8], uint16(unix.NLM_F_REQUEST))
+	binary.NativeEndian.PutUint32(req[8:12], 1)
+	req[syscall.NLMSG_HDRLEN] = byte(family)
+	req[syscall.NLMSG_HDRLEN+1] = nfNetlinkV0
+	copy(req[syscall.NLMSG_HDRLEN+4:], attrs)
+	return req
+}
+
+func conntrackNetlinkMsgType(msgType int) uint16 {
+	return uint16((nfSubsysCTNetlink << 8) | msgType)
+}
+
+func conntrackTupleAttrs(src, dst net.IP, srcPort, dstPort uint16, proto uint8) (int, []byte, error) {
+	family := unix.AF_INET6
+	var ipAttrs []byte
+	if src4, dst4 := src.To4(), dst.To4(); src4 != nil && dst4 != nil {
+		family = unix.AF_INET
+		ipAttrs = appendNetlinkAttr(ipAttrs, ctaIPV4Src, src4)
+		ipAttrs = appendNetlinkAttr(ipAttrs, ctaIPV4Dst, dst4)
+	} else {
+		src16, dst16 := src.To16(), dst.To16()
+		if src16 == nil || dst16 == nil {
+			return 0, nil, fmt.Errorf("invalid conntrack tuple: %s -> %s", src, dst)
+		}
+		ipAttrs = appendNetlinkAttr(ipAttrs, ctaIPV6Src, src16)
+		ipAttrs = appendNetlinkAttr(ipAttrs, ctaIPV6Dst, dst16)
+	}
+
+	var protoAttrs []byte
+	protoAttrs = appendNetlinkAttr(protoAttrs, ctaProtoNum, []byte{proto})
+	var portBuf [2]byte
+	binary.BigEndian.PutUint16(portBuf[:], srcPort)
+	protoAttrs = appendNetlinkAttr(protoAttrs, ctaProtoSrc, portBuf[:])
+	binary.BigEndian.PutUint16(portBuf[:], dstPort)
+	protoAttrs = appendNetlinkAttr(protoAttrs, ctaProtoDst, portBuf[:])
+
+	var tuple []byte
+	tuple = appendNetlinkAttr(tuple, ctaTupleIP|nlaFNested, ipAttrs)
+	tuple = appendNetlinkAttr(tuple, ctaTupleProto|nlaFNested, protoAttrs)
+	var attrs []byte
+	attrs = appendNetlinkAttr(attrs, ctaTupleOrig|nlaFNested, tuple)
+	return family, attrs, nil
+}
+
+func appendNetlinkAttr(dst []byte, attrType uint16, data []byte) []byte {
+	attrLen := 4 + len(data)
+	alignedLen := alignNetlinkAttr(attrLen)
+	start := len(dst)
+	dst = append(dst, make([]byte, alignedLen)...)
+	binary.NativeEndian.PutUint16(dst[start:start+2], uint16(attrLen))
+	binary.NativeEndian.PutUint16(dst[start+2:start+4], attrType)
+	copy(dst[start+4:start+4+len(data)], data)
+	return dst
+}
+
+func parseConntrackMark(data []byte) uint32 {
+	if len(data) <= 4 {
+		return 0
+	}
+	attrs := data[4:]
+	for len(attrs) >= 4 {
+		attrLen := int(binary.NativeEndian.Uint16(attrs[0:2]))
+		if attrLen < 4 || attrLen > len(attrs) {
+			return 0
+		}
+		attrType := binary.NativeEndian.Uint16(attrs[2:4]) & nlaTypeMask
+		if attrType == ctaMark && attrLen >= 8 {
+			return binary.BigEndian.Uint32(attrs[4:8])
+		}
+		attrs = attrs[alignNetlinkAttr(attrLen):]
+	}
+	return 0
+}
+
+func alignNetlinkAttr(length int) int {
+	return (length + 3) & ^3
+}
